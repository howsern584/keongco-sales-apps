# Copy this file to ".env" and fill in real values.
# The .env file is NEVER committed to git (it can hold secrets).

# Which database to use.
# Phase 1 & 2 (now): a local SQLite file — zero install needed.
DATABASE_URL=sqlite:///./keongco.db

# Phase 3 (later, production): switch to PostgreSQL by changing ONLY this line, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/keongco
